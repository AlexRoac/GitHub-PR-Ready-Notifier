{
  "manifest_version": 3,
  "name": "GitHub PR Ready Notifier",
  "description": "Notifies you when an open GitHub pull request becomes ready to Squash and merge.",
  "version": "1.1.0",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["alarms", "notifications", "storage", "tabs"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GitHub PR Ready Notifier",
    "default_icon": "icon128.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon128.png"],
      "matches": ["https://github.com/*"]
    }
  ]
}
